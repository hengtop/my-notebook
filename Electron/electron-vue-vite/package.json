{
  "name": "electron-vue-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/main/mainEntry.js",
  "author": "topzhang",
  "description": "electron-vue-vite-demo",
  "scripts": {
    "dev": "nodemon --exec vite --watch ./src/main --ext .js",
    "build": "vite build",
    "preview": "vite preview",
    "build:win": "npm run build && electron-builder",
    "build-icon": "electron-icon-builder --input=./src/assets/icon.jpg --flatten"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "vite": "^7.1.2",
    "vite-plugin-optimizer": "^1.4.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.topzhang.electrondemo",
    "productName": "electron-vue-vite",
    "directories": {
      "output": "build"
    },
    "win": {
      "icon": "./icons/256x256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "electron-vue-vite-s"
    }
  }
}
